// use prisma-8

// Added by better-auth-adapter-prisma8 via `@better-auth/cli generate`.
model User {
  id            String                     @id // id is generated by Better Auth, not the database
  name          String // sortable
  email         String                     @unique // sortable
  emailVerified Boolean                    @default(false)
  image         String?

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
  
  sessions      Session[]
  accounts      Account[]
  trainingPlans TrainingPlan[]
  planLikes     PlanLike[]
  workoutSessions WorkoutSession[]

  @@map("user")
}

model Session {
  id        String                     @id // id is generated by Better Auth, not the database
  expiresAt DateTime
  token     String                     @unique
  ipAddress String?
  userAgent String?

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String                     @id // id is generated by Better Auth, not the database
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String                     @id // id is generated by Better Auth, not the database
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
  @@map("verification")
}

model TrainingPlan {
  id String @id
  userId String
  name String
  description String?
  visibility String @default("private")
  status String @default("draft")
  likeCount Int @default(0)
  copiedFromPlanId String?
  copiedFromName String?
  copiedFromAuthorName String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  copiedFromPlan TrainingPlan? @relation("PlanCopies", fields: [copiedFromPlanId], references: [id], onDelete: SetNull)
  copies TrainingPlan[] @relation("PlanCopies")
  sessions PlanSession[]
  likes PlanLike[]
  workoutSessions WorkoutSession[]

  @@index([userId])
  @@index([visibility])
  @@map("training_plan")
}

model PlanSession {
  id String @id
  planId String
  name String
  position Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises PlanExercise[]

  @@unique([planId, position])
  @@index([planId])
  @@map("plan_session")
}

model PlanExercise {
  id String @id
  sessionId String
  name String
  muscleGroup String
  position Int
  sets Int
  repsMin Int?
  repsMax Int?
  durationMin Int?
  weightValue Float?
  weightUnit String?
  restMin Int @default(4)
  notes String?
  demoUrls String[] @default([])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  session PlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([sessionId])
  @@index([muscleGroup])
  @@map("plan_exercise")
}

model PlanLike {
  id String @id
  planId String
  userId String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
  @@map("plan_like")
}

model WorkoutSession {
  id String @id
  userId String
  planId String
  planSessionId String
  planNameSnapshot String
  planAuthorNameSnapshot String
  sessionNameSnapshot String
  startedAt TimestamptzString @default(now())
  completedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planSession PlanSession @relation(fields: [planSessionId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId])
  @@index([userId, planId])
  @@index([planSessionId])
  @@map("workout_session")
}

model WorkoutSet {
  id String @id
  workoutSessionId String
  exercisePosition Int
  setNumber Int
  exerciseNameSnapshot String
  muscleGroupSnapshot String
  reps Int?
  durationSec Int?
  weightValue Float?
  weightUnit String?
  skipped Boolean @default(false)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, exercisePosition, setNumber])
  @@index([workoutSessionId])
  @@map("workout_set")
}

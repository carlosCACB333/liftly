// use prisma-8

// Added by better-auth-adapter-prisma8 via `@better-auth/cli generate`.
model User {
  id            String                     @id // id is generated by Better Auth, not the database
  name          String // sortable
  email         String                     @unique // sortable
  emailVerified Boolean                    @default(false)
  image         String?

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
  
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String                     @id // id is generated by Better Auth, not the database
  expiresAt DateTime
  token     String                     @unique
  ipAddress String?
  userAgent String?

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String                     @id // id is generated by Better Auth, not the database
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String                     @id // id is generated by Better Auth, not the database
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
  @@map("verification")
}

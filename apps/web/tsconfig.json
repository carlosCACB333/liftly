{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@internal/contract/types": ["../../packages/db/src/prisma/internal-contract-types.d.ts"],
      "@internal/sql-contract/types": ["../../packages/db/src/prisma/internal-sql-contract-types.d.ts"],
      "@internal/target-postgres/*": ["../../packages/db/src/prisma/internal-target-postgres-*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

# Base URL of the app. Better Auth uses it to build callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# Secret used by Better Auth to sign cookies and tokens. Generate one with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=your-secret-here

# PostgreSQL connection string (requires PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Social providers. Remove the ones you do not use.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=